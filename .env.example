# OpenTrusty CLI Configuration
# Per-binary env file for the `opentrusty` CLI tool.
# Copy to .env or /etc/opentrusty/cli.env and adjust values.

# ─── Database (Discrete Fields) ───────────────────────────────────────────────
# Direct PostgreSQL connection parameters.
# OPENTRUSTY_DATABASE_URL is deprecated; use discrete fields below.
OPENTRUSTY_DB_HOST=localhost
OPENTRUSTY_DB_PORT=5432
OPENTRUSTY_DB_USER=postgres
OPENTRUSTY_DB_PASSWORD=password
OPENTRUSTY_DB_NAME=opentrusty
OPENTRUSTY_DB_SSLMODE=disable

# ─── General ──────────────────────────────────────────────────────────────────
OPENTRUSTY_LOG_LEVEL=info

# ─── Security ─────────────────────────────────────────────────────────────────
# Shared HMAC key for PII hashing. MUST be identical across Auth, Admin, and CLI.
# Generate with: openssl rand -hex 32
OPENTRUSTY_IDENTITY_SECRET=change-me-in-production

# ─── Bootstrap ────────────────────────────────────────────────────────────────
# Credentials for the initial Platform Admin created during `opentrusty bootstrap`.
# Only used during first-time setup. Remove or rotate after bootstrap.
OPENTRUSTY_BOOTSTRAP_ADMIN_EMAIL=admin@opentrusty.org
OPENTRUSTY_BOOTSTRAP_ADMIN_PASSWORD=adminadmin
